# Hosted Stripe Checkout. Leave blank in local development to use demo mode.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Standard Postgres URL for Vercel, Netlify and local development.
# On Cloudflare, prefer the HYPERDRIVE binding instead.
DATABASE_URL=

# Generate once with: openssl rand -base64 32
CHECKOUT_PII_KEY=
# Generate once with: openssl rand -hex 32
CHECKOUT_LOOKUP_PEPPER=

# Generate with: npm run admin:hash -- "a-long-password"
ADMIN_PASSWORD_HASH=
# Generate once with: openssl rand -hex 32
ADMIN_SESSION_SECRET=

# Public base URL used by Stripe return links.
APP_URL=http://localhost:5173

# Bearer token for the MCP endpoint at /api/mcp. Leave blank to disable it.
# Generate with: openssl rand -hex 32
MCP_TOKEN=
# Set to true to let MCP clients read full buyer names, addresses and phone
# numbers. Left unset, order tools return redacted buyer details.
MCP_ALLOW_PII=
